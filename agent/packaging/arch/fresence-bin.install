_user_home() {
    [[ -n ${SUDO_USER:-} ]] && getent passwd "$SUDO_USER" | cut -d: -f6
}

_hint_old_install() {
    local home
    home=$(_user_home)
    [[ -n $home && -e $home/.config/systemd/user/fresence.service ]] || return 0
    cat <<'EOF'
==> An install.sh setup is still in your home and overrides this package.
    Remove it as your user, keeping your account and data:
      systemctl --user disable --now fresence
      rm -f ~/.config/systemd/user/fresence.service ~/.local/bin/fresence ~/.local/bin/fresence-desktop
      rm -f ~/.local/share/applications/fresence.desktop ~/.local/share/fresence/fresence-third-party-notices.txt
      rm -rf ~/.local/share/fresence/desktop
      systemctl --user daemon-reload
EOF
}

post_install() {
    _hint_old_install
    cat <<'EOF'
==> Start the agent as your user:
      systemctl --user enable --now fresence
    then one of:
      fresence join <invite>        first device, by an invite
      fresence link <offer>         accept an offer shown by your linked device
      fresence link --server <url>  show an offer to scan from your linked device
EOF
}

post_upgrade() {
    _hint_old_install
    echo "==> Restart the agent to run the new version: systemctl --user restart fresence"
}
