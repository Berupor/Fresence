_user_home() {
    [[ -n ${SUDO_USER:-} ]] && getent passwd "$SUDO_USER" | cut -d: -f6
}

_hint_old_install() {
    local home
    home=$(_user_home)
    [[ -n $home && -e $home/.local/share/fresence/desktop ]] || return 0
    cat <<'EOF'
==> An install.sh copy of Fresence is still in your home and its menu entry overrides this package.
    Remove it as your user, keeping your account and data:
      rm -f ~/.local/bin/fresence-desktop ~/.local/share/applications/fresence.desktop
      rm -f ~/.local/share/fresence/fresence-third-party-notices.txt
      rm -rf ~/.local/share/fresence/desktop
EOF
}

_hint_start() {
    cat <<'EOF'
==> Start Fresence from the menu or with fresence-desktop.
    An account from the old fresence agent moves over by itself on the first start.
EOF
}

post_install() {
    _hint_old_install
    _hint_start
}

post_upgrade() {
    _hint_old_install
    _hint_start
}
